\name{ISMatricesLoop}
\alias{ISMatricesLoop}

\title{Internal function to loop Over Indicator Saturation Matrices with 
Block-Based GETS}

\description{
  Loops through each IS matrix and performs block-based 
  GETS model selection, using optional parallelisation.
}

\usage{
ISMatricesLoop(blocks.is.list, ISmatrices, ratio.threshold, mXncol,
  parallel.options, i, ISblocks, y, y.n, mX, userEstArg, t.pval, wald.pval, 
  do.pet, arLjungB, archLjungB, normality.JarqueB, user.diagnostics, gofFunArg, 
  gof.method, mxkeep, include.gum, include.1cut, include.empty, max.paths, 
  turbo, tol, LAPACK, max.regs, print.searchinfo, clusterSpec, clusterVarlist, 
  blocks, max.block.size, mXnames)
}

\arguments{
  \item{blocks.is.list}{
    Logical; if \code{TRUE}, assumes that \code{ISblocks} already contains a 
    user-supplied block structure. If \code{FALSE}, blocks are generated 
    internally.
  }
  \item{ISmatrices}{
    List of indicator saturation matrices, typically generated by 
    \code{create.ISmatrices}, containing IIS, SIS, TIS, or UIS.
  }
  \item{ratio.threshold}{
    Numeric value used to determine the minimum ratio of observations to 
    regressors in each block.
  }
  \item{mXncol}{
    Number of columns in the original regressor matrix \code{mX}, used to 
    ensure feasible model sizes.
  }
  \item{parallel.options}{
    If not \code{NULL}, enables parallel processing with specified number of 
    cores or a cluster object.
  }
  \item{i}{
    Index of the current IS matrix in \code{ISmatrices} being processed.
  }
  \item{ISblocks}{
    List of index blocks for each IS matrix. Can be partially pre-defined 
    or built internally.
  }
  \item{y}{
    Response variable, a numeric vector or time-series.
  }
  \item{y.n}{
    Number of observations in the response variable.
  }
  \item{mX}{
    Matrix of regressors excluding indicator variables.
  }
  \item{userEstArg}{
    List specifying the user-defined estimator function and its arguments, 
    passed to \code{getsFun}.
  }
  \item{t.pval}{
    Significance threshold for t-tests in the GETS model selection process.
  }
  \item{wald.pval}{
    Significance threshold for Wald tests in the GETS process.
  }
  \item{do.pet}{
    Logical; if \code{TRUE}, Parsimonious Encompassing Tests are performed 
    during deletion steps.
  }
  \item{arLjungB}{
    List with AR order and significance level for the Ljung-Box test for 
    autocorrelation in residuals.
  }
  \item{archLjungB}{
    List with ARCH order and significance level for testing heteroskedasticity 
    in residuals.
  }
  \item{normality.JarqueB}{
    Significance level for the Jarque-Bera normality test. If \code{NULL}, 
    the test is skipped.
  }
  \item{user.diagnostics}{
    List containing user-specified diagnostics function and p-value settings, 
    passed to \code{getsFun}.
  }
  \item{gofFunArg}{
    List specifying the name and parameters of the goodness-of-fit function 
    used.
  }
  \item{gof.method}{
    Character string specifying whether the GOF criterion is 
    minimized (\code{"min"}) or maximized (\code{"max"}).
  }
  \item{mxkeep}{
    Integer indices of regressors that are forced to be retained in 
    the model.
  }
  \item{include.gum}{
    Logical; if \code{TRUE}, the General Unrestricted Model is included as a 
    terminal model.
  }
  \item{include.1cut}{
    Logical; if \code{TRUE}, the one-cut model is included as a terminal model.
  }
  \item{include.empty}{
    Logical; if \code{TRUE}, the empty model is included among terminal models.
  }
  \item{max.paths}{
    Maximum number of paths to explore in GETS model selection. If \code{NULL}, 
    no limit is imposed.
  }
  \item{turbo}{
    Logical; if \code{TRUE}, avoids redundant path searches in GETS.
  }
  \item{tol}{
    Tolerance threshold for detecting multicollinearity among regressors.
  }
  \item{LAPACK}{
    Logical; if \code{TRUE}, uses LAPACK for QR decomposition in collinearity 
    checks.
  }
  \item{max.regs}{
    Maximum number of regressions to perform per GETS path.
  }
  \item{print.searchinfo}{
    Logical; if \code{TRUE}, progress and diagnostics messages are printed
    during execution.
  }
  \item{clusterSpec}{
    Specification object passed to \code{makeCluster} to control parallel 
    processing.
  }
  \item{clusterVarlist}{
    Character vector listing variable names to be exported to each cluster 
    worker.
  }
  \item{blocks}{
    Integer specifying the number of blocks to divide the IS matrix into. 
    If \code{NULL}, determined automatically.
  }
  \item{max.block.size}{
    Maximum number of indicators per block used during block construction.
  }
  \item{mXnames}{
    Character vector of regressor names in \code{mX}, used to identify 
    retained terms.
  }
}


\value{
A list with:
  \item{ISfinalmodel}{Vector of selected indicator names.}
  \item{estimations.counter}{Updated estimation counter.}
  \item{getsFun.counter}{Updated function call counter.}
  \item{ISblocks}{Final block structure.}
}


