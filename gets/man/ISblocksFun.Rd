\name{ISblocksFun}
\alias{ISblocksFun}

\title{
Internal function to carry out the block-wise GETS search
}
\description{
An internal function that manages the block-wise GETS search within the 
\code{isat()} type functions.
}
\usage{
ISblocksFun(j, i, ISmatrices, ISblocks, mX, parallel.options, y, userEstArg, 
  t.pval, wald.pval, do.pet, arLjungB, archLjungB, normality.JarqueB, 
  user.diagnostics, gofFunArg, gof.method, mxkeep, include.gum, include.1cut, 
  include.empty, max.paths, turbo, tol, LAPACK, max.regs, print.searchinfo, y.n)
}

\arguments{
  \item{j}{
    Index of the current block (within the \code{i}th indicator matrix) to be evaluated.
  }
  \item{i}{
    Index of the indicator matrix from \code{ISmatrices} being processed (e.g., IIS, SIS, TIS).
  }
  \item{ISmatrices}{
    A named list of indicator matrices generated by \code{create.ISmatrices}.
  }
  \item{ISblocks}{
    A list of block index sets corresponding to columns of each indicator 
    matrix, specifying how indicators are grouped for block-wise GETS.
  }
  \item{mX}{
    Matrix of base regressors to which indicator variables are appended.
  }
  \item{parallel.options}{
    Parallel execution control; if \code{NULL}, no parallelism is applied.
  }
  \item{y}{
    Numeric vector or time-series; the dependent variable in the regression 
    model.
  }
  \item{userEstArg}{
    A list containing the user-defined estimation function and its arguments, 
    passed to \code{getsFun}.
  }
  \item{t.pval}{
    Numeric value between 0 and 1; the significance level used for coefficient 
    t-tests during GETS.
  }
  \item{wald.pval}{
    Numeric value; significance level for Wald tests in GETS selection.
  }
  \item{do.pet}{
    Logical; if \code{TRUE}, a Parsimonious Encompassing Test (PET) is 
    conducted after each deletion.
  }
  \item{arLjungB}{
    A two-element list or vector specifying the lag and p-value for the 
    Ljung-Box test on residual autocorrelation.
  }
  \item{archLjungB}{
    A two-element list or vector specifying the lag and p-value for the 
    Ljung-Box test on squared residuals (ARCH test).
  }
  \item{normality.JarqueB}{
    Numeric value or \code{NULL}; p-value threshold for the Jarque-Bera 
    test for normality.
  }
  \item{user.diagnostics}{
    A list specifying a user-defined diagnostics function and its 
    significance levels.
  }
  \item{gofFunArg}{
    List specifying the name and parameters of the goodness-of-fit function.
  }
  \item{gof.method}{
    Character string; either \code{"min"} or \code{"max"} indicating how to 
    choose the best model based on the GOF criterion.
  }
  \item{mxkeep}{
    Indices of variables in \code{mXis} to be forcibly retained during the 
    GETS procedure.
  }
  \item{include.gum}{
    Logical; if \code{TRUE}, includes the General Unrestricted Model in the 
    set of terminal models.
  }
  \item{include.1cut}{
    Logical; if \code{TRUE}, includes the 1-cut model in the set of terminal 
    models.
  }
  \item{include.empty}{
    Logical; if \code{TRUE}, includes the empty model among terminal models 
    if it passes diagnostics.
  }
  \item{max.paths}{
    Maximum number of paths to explore during GETS. If \code{NULL}, 
    no limit is imposed.
  }
  \item{turbo}{
    Logical; avoids redundant path evaluations in GETS for efficiency.
  }
  \item{tol}{
    Numeric tolerance for detecting collinearity in regressors during model 
    estimation.
  }
  \item{LAPACK}{
    Logical; if \code{TRUE}, LAPACK routines are used for matrix decomposition 
    in collinearity checks.
  }
  \item{max.regs}{
    Maximum number of regressions allowed in each deletion path.
  }
  \item{print.searchinfo}{
    Logical; if \code{TRUE}, prints messages about the GETS search progress 
    and block structure.
  }
  \item{y.n}{
    Integer; the number of observations in the dependent variable \code{y}.
  }
}

\value{
Returns a character vector of the names of the retained variables or \code{NULL}.
}


\seealso{
See also \code{\link{isat}}.
}
